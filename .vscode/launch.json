        {"name":"Depurador do Python: Arquivo Atual","type":"debugpy","request":"launch","program":"${file}","console":"integratedTerminal"},
        {
            "type": "editor-browser",
            "request": "launch",
            "name": "Iniciar o Chrome em relação a localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
