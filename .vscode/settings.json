{
  "tailwindCSS.includeLanguages": {
    "html": "html"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "chat.checkpoints.showFileChanges": true,
  "chat.editing.explainChanges.enabled": false,
  "chat.editor.codex.preferAgentHost": true,
  "chat.editor.preferCopilotHarness": true,
  "github.copilot.chat.githubMcpServer.enabled": false,
  "chat.customizations.migration.enabled": false,
  "chat.customizations.locationsMigration.enabled": false,
  "workbench.browser.dataStorage": "agent",
  "workbench.browser.openLocalhostLinks": true,
  "workbench.browser.showInTitleBar": true,
  "workbench.browser.experimentalUserTools.enabled": true,
  "chat.tools.terminal.enableAutoApprove": true,
  "chat.tools.terminal.autoApprove": {
    "/.*/": true
  },
  "antigravity.enableInlineDiff": true
}

